datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- MODELOS DE USUARIOS ---

// Para clientes de la tienda
model User {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  email        String   @unique
  name         String?
  telefono     String?
  passwordHash String? // Nullable para usuarios creados desde el admin o sin cuenta

  // Campos de dirección del usuario
  calle        String?
  colonia      String?
  codigoPostal String?
  ciudad       String?
  estadoEnvio  String?
  pais         String?

  // Campos para verificación y reseteo de contraseña
  emailVerified     DateTime?
  verificationToken String?   @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Relación con Pedidos y Carrito
  pedidos      Pedido[]
  carritoItems CarritoItem[] // Un usuario tiene muchos items en su carrito
  chatSessions ChatSession[] // Un usuario puede tener muchas sesiones de chat

  @@index([verificationToken])
  @@index([resetToken])
}

// Para administradores del panel
model AdminUser {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  email        String   @unique
  name         String
  passwordHash String
}

// --- MODELOS DE PRODUCTOS ---

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  nombre      String
  precio      Float
  descripcion String?
  stock       Int      @default(0)
  imagen      String? // Imagen principal

  // Campos para envío
  pesoKg  Float?
  largoCm Float?
  anchoCm Float?
  altoCm  Float?

  // Relación con Categoria
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  // Relación con Pedidos y Carrito
  pedidos      PedidosEnProductos[]
  carritoItems CarritoItem[] // Un producto puede estar en muchos carritos

  // Relación con la galería de imágenes
  imagenes ImagenProducto[]
}

model ImagenProducto {
  id         Int      @id @default(autoincrement())
  url        String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId Int

  @@index([productoId])
}

// --- MODELOS DE PEDIDOS ---

enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

model Pedido {
  id              Int          @id @default(autoincrement())
  createdAt       DateTime     @default(now())
  orden           String       @unique @default(cuid())
  total           Float
  estado          EstadoPedido @default(PENDIENTE)
  paymentIntentId String?      @unique // ID de la transacción de Stripe

  // Datos del cliente (se guardan en el pedido para el histórico)
  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?

  // Dirección de envío
  direccion    String
  colonia      String?
  ciudad       String?
  estadoEnvio  String?
  codigoPostal String?

  // Relación con User (opcional, para pedidos de invitados)
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // Relación con Productos
  productos PedidosEnProductos[]

  // Relación 1-1 con Envio (opcional)
  envio Envio?

  @@index([paymentIntentId])
}

// Tabla intermedia para la relación muchos-a-muchos Pedido <-> Producto
model PedidosEnProductos {
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId   Int
  producto   Producto @relation(fields: [productoId], references: [id])
  productoId Int
  cantidad   Int

  // Guardar el precio al momento de la compra por si cambia en el futuro
  precioAlComprar Float

  @@id([pedidoId, productoId])
}

// Nuevo modelo para los items del carrito
model CarritoItem {
  id        Int      @id @default(autoincrement())
  cantidad  Int
  createdAt DateTime @default(now())

  // A qué usuario pertenece este item
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Qué producto es
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  // Un usuario solo puede tener una línea por producto (ej: 3x "Producto A")
  @@unique([userId, productoId])
}

// --- MODELO DE ENVÍOS (SKYDROPX, TRACKING, ETC.) ---

model Envio {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Relación 1-1 con Pedido
  pedidoId Int    @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  // Datos de cotización Skydropx
  quotationId String // ID de la cotización usada
  rateId      String // ID de la rate seleccionada
  provider    String? // Paquetería (DHL, Estafeta, etc.)
  service     String? // Nombre del servicio
  days        Int? // Días estimados

  // Costos
  costoEnvio Float
  moneda     String @default("MXN")

  // Datos del envío real / guía
  labelId            String? // ID de la etiqueta (labels) en Skydropx
  skydropxShipmentId String? // Si en algún momento usas /shipments
  trackingNumber     String? // Número de rastreo
  trackingUrl        String? // URL de rastreo
  etiquetaUrl        String? // URL de la etiqueta (PDF/ZPL/etc.)
  status             String? // Estado del envío según Skydropx
}

enum ImageContext {
  MODEL_BASE // Imagen base del modelo (sin tinaco, sin alcalina)
  MODEL_BASE_ALCALINA // Modelo + solo agua alcalina (sin tinaco)
  TINACO // Tinaco normal
  TINACO_ALCALINA // Tinaco con agua alcalina
  SECONDARY // Imagen secundaria (vending, etc.)
  SECONDARY_ALCALINA // Secundaria cuando hay agua alcalina
  CAROUSEL // Para los carruseles de los primeros pasos
}

enum VendingType {
  TRADICIONAL
  TOUCH
  NONE // Para Purificadoras o Vending-Limpieza
}

model MachineModel {
  id              String      @id @default(cuid())
  slug            String      @unique // "Neptuno", "AtlantisMaxTouch", etc.
  name            String
  basePrice       Int         @default(0)
  description     String?
  features        String[]    @default([])
  supportsTinacos Boolean     @default(true)
  isAtlantis      Boolean     @default(false)
  vendingType     VendingType @default(NONE)

  extras ModelExtra[]
  images ConfigurationImage[]
}

model Extra {
  id          String  @id @default(cuid())
  code        String  @unique // "tinaco-2500", "agua-alcalina", etc.
  name        String
  description String
  basePrice   Int
  isTinaco    Boolean @default(false)

  // Datos adicionales útiles para tinacos (opcional)
  tinacoKey            String?
  tinacoCapacityLiters Int?

  models ModelExtra[]
  images ConfigurationImage[] @relation("TinacoImage")
}

model ModelExtra {
  id String @id @default(cuid())

  model   MachineModel @relation(fields: [modelId], references: [id])
  modelId String

  extra   Extra  @relation(fields: [extraId], references: [id])
  extraId String

  // Permite precio por modelo
  priceOverride Int?
  isDefault     Boolean @default(false)
  isRequired    Boolean @default(false)
  sortOrder     Int     @default(0)

  @@unique([modelId, extraId])
}

model ConfigurationImage {
  id String @id @default(cuid())

  model   MachineModel @relation(fields: [modelId], references: [id])
  modelId String

  // Opcional: imagen vinculada a un tinaco concreto
  tinacoExtra   Extra?  @relation("TinacoImage", fields: [tinacoExtraId], references: [id])
  tinacoExtraId String?

  context          ImageContext
  onlyWhenAlcalina Boolean      @default(false)

  // Imagen secundaria (vending)
  isSecondary Boolean @default(false)

  // Variante de diseño secundaria (4 botones, 8 botones, touch, etc.)
  secondaryVariantKey String?
  url                 String
  alt                 String
  priority            Int     @default(0)

  @@index([modelId])
  @@index([tinacoExtraId])
  @@index([context])
}

// --- MODELOS DE CHATBOT ---
model ChatSession {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int? // Opcional, para vincular a usuarios logueados
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  content   String      @db.Text // Usar tipo Text para mensajes largos
  from      String // "user" o "bot"
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatIntent {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name String @unique // e.g., "saludo", "precio_vending"
  description String?
  trainingPhrases String[] // Frases de ejemplo: ["hola", "buenos dias"]
  response String @db.Text
}

// --- MODELO DE CONFIGURACIÓN GENERAL ---

model Configuration {
  id String @id @default(cuid())
  key String @unique
  value String
}

model Meeting {
  id               String   @id @default(cuid())
  topic            String
  startTime        DateTime
  duration         Int
  joinUrl          String   @db.Text
  participantName  String
  participantEmail String
  participantPhone String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("Meeting")
}

