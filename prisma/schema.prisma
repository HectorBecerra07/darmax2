datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Si NO necesitas ese output raro, déjalo así de simple:
generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  email        String   @unique
  name         String
  passwordHash String
}
